# ── Local development ──────────────────────────────────────────────────────────
# Leave VITE_API_URL blank. Vite automatically proxies /api → localhost:3001.
# You only need to set it for production.

# ── Production (Netlify / Vercel) ──────────────────────────────────────────────
# After deploying the backend to Render, paste the URL it gives you here.
# Then add this variable in your Netlify/Vercel environment settings dashboard.
VITE_API_URL=https://ai-scheme-finder.onrender.com
